--[[ 
   QasyrStore HUB | Quantum Hub Clone Style
   Blox Fruits All In One
]]

repeat wait() until game:IsLoaded()
local Players = game:GetService("Players")
local player = Players.LocalPlayer
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VirtualUser = game:GetService("VirtualUser")
local TweenService = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

-- Anti AFK
player.Idled:Connect(function()
    VirtualUser:Button2Down(Vector2.new(0,0),workspace.CurrentCamera.CFrame)
    wait(1)
    VirtualUser:Button2Up(Vector2.new(0,0),workspace.CurrentCamera.CFrame)
end)

-- Load Rayfield (UI library Quantum Hub style)
local Rayfield = loadstring(game:HttpGet("https://raw.githubusercontent.com/shlexware/Rayfield/main/source"))()

local Window = Rayfield:CreateWindow({
   Name = "QasyrStore HUB",
   LoadingTitle = "QasyrStore Loading...",
   LoadingSubtitle = "Quantum Hub Clone",
   ConfigurationSaving = {
      Enabled = true,
      FolderName = "QasyrStore", 
      FileName = "BloxFruitsConfig"
   },
   Discord = {
      Enabled = false,
   },
   KeySystem = false
})

-- SETTINGS
getgenv().Settings = {
    AutoFarm = false,
    AutoQuest = false,
    AutoHaki = false,
    AutoSkill = false,
    BringMob = false,
    AutoStats = false,
    AutoBoss = false,
    Teleport = "None"
}

-- Create Tabs like Quantum Hub
local FarmingTab = Window:CreateTab("Farming", 4483362458)
local PlayerTab = Window:CreateTab("Player", 4483362458)
local BossTab = Window:CreateTab("Boss", 4483362458)
local TeleportTab = Window:CreateTab("Teleport", 4483362458)

-- Farming Tab Toggles
FarmingTab:CreateToggle({
    Name = "Auto Farm",
    CurrentValue = false,
    Flag = "AutoFarmToggle",
    Callback = function(val) getgenv().Settings.AutoFarm = val end
})
FarmingTab:CreateToggle({
    Name = "Auto Quest",
    CurrentValue = false,
    Flag = "AutoQuestToggle",
    Callback = function(val) getgenv().Settings.AutoQuest = val end
})
FarmingTab:CreateToggle({
    Name = "Bring Mob",
    CurrentValue = false,
    Flag = "BringMobToggle",
    Callback = function(val) getgenv().Settings.BringMob = val end
})
FarmingTab:CreateToggle({
    Name = "Auto Skill",
    CurrentValue = false,
    Flag = "AutoSkillToggle",
    Callback = function(val) getgenv().Settings.AutoSkill = val end
})
FarmingTab:CreateToggle({
    Name = "Auto Haki",
    CurrentValue = false,
    Flag = "AutoHakiToggle",
    Callback = function(val) getgenv().Settings.AutoHaki = val end
})

-- Player Tab
PlayerTab:CreateToggle({
    Name = "Auto Stats",
    CurrentValue = false,
    Flag = "AutoStatsToggle",
    Callback = function(val) getgenv().Settings.AutoStats = val end
})

-- Boss Tab
BossTab:CreateToggle({
    Name = "Auto Boss",
    CurrentValue = false,
    Flag = "AutoBossToggle",
    Callback = function(val) getgenv().Settings.AutoBoss = val end
})

-- Teleport Tab
TeleportTab:CreateDropdown({
    Name = "Teleport Island",
    Options = {"None","Starter Island","Desert Island","Frozen Island"},
    CurrentOption = "None",
    Flag = "TeleportDropdown",
    Callback = function(option)
        getgenv().Settings.Teleport = option
        -- Teleport Function
        if option ~= "None" then
            local pos = {["Starter Island"] = Vector3.new(0,0,0),
                         ["Desert Island"] = Vector3.new(500,0,500),
                         ["Frozen Island"] = Vector3.new(1000,0,1000)}
            if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                player.Character.HumanoidRootPart.CFrame = CFrame.new(pos[option])
            end
        end
    end
})

-- FUNCTIONS
function EquipWeapon()
    for _,v in pairs(player.Backpack:GetChildren()) do
        if v:IsA("Tool") then
            player.Character.Humanoid:EquipTool(v)
            return
        end
    end
end

function Attack()
    VirtualUser:Button1Down(Vector2.new(0,0),workspace.CurrentCamera.CFrame)
    wait(0.05)
    VirtualUser:Button1Up(Vector2.new(0,0),workspace.CurrentCamera.CFrame)
end

function UseSkill()
    local vim = game:GetService("VirtualInputManager")
    vim:SendKeyEvent(true,"Z",false,game)
    vim:SendKeyEvent(true,"X",false,game)
    vim:SendKeyEvent(true,"C",false,game)
    vim:SendKeyEvent(true,"V",false,game)
end

function Bring(mob)
    mob.HumanoidRootPart.Size = Vector3.new(50,50,50)
    mob.HumanoidRootPart.Transparency = 1
    mob.HumanoidRootPart.CanCollide = false
    mob.HumanoidRootPart.CFrame = player.Character.HumanoidRootPart.CFrame * CFrame.new(0,0,-5)
end

-- AUTO HAKI
spawn(function()
    while wait(1) do
        if getgenv().Settings.AutoHaki then
            if not player.Character:FindFirstChild("HasBuso") then
                pcall(function()
                    ReplicatedStorage.Remotes.CommF_:InvokeServer("Buso")
                end)
            end
        end
    end
end)

-- AUTO STATS
spawn(function()
    while wait(0.5) do
        if getgenv().Settings.AutoStats then
            pcall(function()
                ReplicatedStorage.Remotes.CommF_:InvokeServer("AddPoint","Melee",1)
                ReplicatedStorage.Remotes.CommF_:InvokeServer("AddPoint","Defense",1)
            end)
        end
    end
end)

-- MAIN AUTO FARM LOOP
spawn(function()
    while wait() do
        if getgenv().Settings.AutoFarm then
            pcall(function()
                EquipWeapon()
                for _,mob in pairs(workspace.Enemies:GetChildren()) do
                    if mob:FindFirstChild("Humanoid") and mob.Humanoid.Health > 0 then
                        repeat
                            player.Character.HumanoidRootPart.CFrame =
                                mob.HumanoidRootPart.CFrame * CFrame.new(0,0,5)
                            if getgenv().Settings.BringMob then
                                Bring(mob)
                            end
                            if getgenv().Settings.AutoSkill then
                                UseSkill()
                            end
                            Attack()
                            wait()
                        until mob.Humanoid.Health <= 0 or not getgenv().Settings.AutoFarm
                    end
                end
            end)
        end
    end
end)

-- AUTO BOSS
spawn(function()
    while wait(3) do
        if getgenv().Settings.AutoBoss then
            for _,boss in pairs(workspace.Enemies:GetChildren()) do
                if boss.Name:find("Boss") then
                    repeat
                        player.Character.HumanoidRootPart.CFrame =
                            boss.HumanoidRootPart.CFrame * CFrame.new(0,0,8)
                        Attack()
                        wait()
                    until boss.Humanoid.Health <= 0
                end
            end
        end
    end
end)

print("✅ QasyrStore HUB Quantum Hub Clone Loaded")
