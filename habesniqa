-- TAB BUTTON
local function Tab(name, cb)
    local b = Instance.new("TextButton", tabs)
    b.Size = UDim2.new(1,-20,0,40)
    b.BackgroundColor3 = Color3.fromRGB(45,45,45)
    b.Text = name
    b.Font = Enum.Font.GothamBold
    b.TextSize = 14
    b.TextColor3 = Color3.fromRGB(255,255,255)
    b.BorderSizePixel = 0
    Instance.new("UICorner", b).CornerRadius = UDim.new(0,10)
    b.MouseButton1Click:Connect(cb)
end

-- CLEAR CONTENT
local function Clear()
    for _,v in ipairs(content:GetChildren()) do
        if v:IsA("TextButton") then v:Destroy() end
    end
end

-- TOGGLE (Speed Hub style)
local function Toggle(txt)
    local on = false
    local b = Instance.new("TextButton", content)
    b.Size = UDim2.new(1,-30,0,42)
    b.BackgroundColor3 = Color3.fromRGB(60,60,60)
    b.Text = "OFF  |  "..txt
    b.Font = Enum.Font.Gotham
    b.TextSize = 14
    b.TextColor3 = Color3.fromRGB(255,255,255)
    b.BorderSizePixel = 0
    Instance.new("UICorner", b).CornerRadius = UDim.new(0,10)

    b.MouseButton1Click:Connect(function()
        on = not on
        b.Text = (on and "ON   |  " or "OFF  |  ")..txt
        b.BackgroundColor3 = on and Color3.fromRGB(0,180,120) or Color3.fromRGB(60,60,60)
    end)
end

-- PAGES
