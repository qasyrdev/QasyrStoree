-- Function create Tab
local function createTab(name)
    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1,-20,0,40)
    b.Text = name
    b.Font = Enum.Font.GothamBold
    b.TextSize = 14
    b.TextColor3 = Color3.fromRGB(255,255,255)
    b.BackgroundColor3 = Color3.fromRGB(35,35,35)
    b.BorderSizePixel = 0
    b.Parent = Tabs
    Instance.new("UICorner", b).CornerRadius = UDim.new(0,8)
    return b
end

-- Function create Toggle
local function createToggle(text)
    local t = Instance.new("TextButton")
    t.Size = UDim2.new(1,-30,0,40)
    t.Text = "OFF | "..text
    t.Font = Enum.Font.Gotham
    t.TextSize = 14
    t.TextColor3 = Color3.fromRGB(255,255,255)
    t.BackgroundColor3 = Color3.fromRGB(40,40,40)
    t.BorderSizePixel = 0
    t.Parent = Content
    Instance.new("UICorner", t).CornerRadius = UDim.new(0,8)

    local on = false
    t.MouseButton1Click:Connect(function()
        on = not on
        t.Text = (on and "ON  | " or "OFF | ")..text
        t.BackgroundColor3 = on and Color3.fromRGB(0,170,127) or Color3.fromRGB(40,40,40)
    end)
end

-- Tabs
local FarmingTab = createTab("Farming")
local PlayerTab  = createTab("Player")
local TeleportTab = createTab("Teleport")

-- Load Farming Content
local function loadFarming()
    for _,v in pairs(Content:GetChildren()) do
        if v:IsA("TextButton") then v:Destroy() end
    end
    createToggle("Auto Farm")
    createToggle("Auto Quest")
    createToggle("Bring Mob")
    createToggle("Auto Haki")
    createToggle("Auto Skill")
end

FarmingTab.MouseButton1Click:Connect(loadFarming)
loadFarming()

