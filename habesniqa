-- FUNCTION TO CREATE BUTTON TOGGLE
local function CreateToggle(name, setting)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1,-10,0,40)
    btn.Text = name.." : OFF"
    btn.TextScaled = true
    btn.BackgroundColor3 = Color3.fromRGB(50,50,50)
    btn.TextColor3 = Color3.fromRGB(255,255,255)
    btn.Parent = PanelFrame
    btn.MouseButton1Click:Connect(function()
        getgenv().Settings[setting] = not getgenv().Settings[setting]
        btn.Text = name.." : "..(getgenv().Settings[setting] and "ON" or "OFF")
    end)
end

-- Tabs
local Tabs = {"Farming","Player","Boss","Teleport"}
local CurrentTab = "Farming"

local function UpdatePanel()
    -- Clear old
    for _,v in pairs(PanelFrame:GetChildren()) do
        if v:IsA("TextButton") then
            v:Destroy()
        end
    end
    -- Populate based on tab
    if CurrentTab == "Farming" then
        CreateToggle("Auto Farm","AutoFarm")
        CreateToggle("Bring Mob","BringMob")
        CreateToggle("Auto Skill","AutoSkill")
        CreateToggle("Auto Haki","AutoHaki")
    elseif CurrentTab == "Player" then
        CreateToggle("Auto Stats","AutoStats")
    elseif CurrentTab == "Boss" then
        CreateToggle("Auto Boss","AutoBoss")
    elseif CurrentTab == "Teleport" then
        local drop = Instance.new("TextButton")
        drop.Size = UDim2.new(1,-10,0,40)
        drop.Text = "Teleport Island"
        drop.TextScaled = true
        drop.BackgroundColor3 = Color3.fromRGB(50,50,50)
        drop.TextColor3 = Color3.fromRGB(255,255,255)
        drop.Parent = PanelFrame
        drop.MouseButton1Click:Connect(function()
            local pos = {["Starter Island"] = Vector3.new(0,0,0),
                         ["Desert Island"] = Vector3.new(500,0,500),
                         ["Frozen Island"] = Vector3.new(1000,0,1000)}
            getgenv().Settings.Teleport = "Desert Island"
            if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                player.Character.HumanoidRootPart.CFrame = CFrame.new(pos["Desert Island"])
            end
        end)
    end
end

-- Create Tabs buttons
for _,tabName in pairs(Tabs) do
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1,-10,0,40)
    btn.Text = tabName
    btn.TextScaled = true
    btn.BackgroundColor3 = Color3.fromRGB(60,60,60)
    btn.TextColor3 = Color3.fromRGB(255,255,255)
    btn.Parent = TabFrame
    btn.MouseButton1Click:Connect(function()
        CurrentTab = tabName
        UpdatePanel()
    end)
end

UpdatePanel() -- Initial populate

-- FUNCTIONS
function EquipWeapon()
    for _,v in pairs(player.Backpack:GetChildren()) do
        if v:IsA("Tool") then
            player.Character.Humanoid:EquipTool(v)
            return
        end
    end
end

function Attack()
    VirtualUser:Button1Down(Vector2.new(0,0),workspace.CurrentCamera.CFrame)
    wait(0.05)
    VirtualUser:Button1Up(Vector2.new(0,0),workspace.CurrentCamera.CFrame)
end

function UseSkill()
    local vim = game:GetService("VirtualInputManager")
    vim:SendKeyEvent(true,"Z",false,game)
    vim:SendKeyEvent(true,"X",false,game)
    vim:SendKeyEvent(true,"C",false,game)
    vim:SendKeyEvent(true,"V",false,game)
end

function Bring(mob)
    mob.HumanoidRootPart.Size = Vector3.new(50,50,50)
    mob.HumanoidRootPart.Transparency = 1
    mob.HumanoidRootPart.CanCollide = false
    mob.HumanoidRootPart.CFrame = player.Character.HumanoidRootPart.CFrame * CFrame.new(0,0,-5)
end

